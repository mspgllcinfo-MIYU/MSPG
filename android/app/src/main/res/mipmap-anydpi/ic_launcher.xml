<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy (pre-API 26) fallback: the same two layers as
     mipmap-anydpi-v26/ic_launcher.xml, just stacked directly instead of
     through <adaptive-icon> (which older platforms don't understand).
     Resource resolution picks the -v26 adaptive version automatically on
     API 26+ and this flat composite otherwise. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
