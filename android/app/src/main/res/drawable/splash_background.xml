<?xml version="1.0" encoding="utf-8"?>
<!-- PRESENTATION-01: plain windowBackground splash (no SplashScreen
     library, no extra Activity, no custom delay); black full-bleed
     with the app artwork centered. Android swaps this for the real
     content the instant MainActivity's first frame draws, so there is
     no code-controlled timing here at all. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
    <item android:gravity="center" android:drawable="@drawable/splash_icon" />
</layer-list>
