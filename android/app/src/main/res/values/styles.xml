<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PRESENTATION-01: extends the project's existing plain framework
         theme with only a windowBackground (classic zero-dependency
         splash trick, safe back to minSdk 24) and, where the platform
         understands it (API 31+), a black windowSplashScreenBackground
         so the OS-driven splash on newer devices stays black too instead
         of a default white flash before our own background takes over.
         android:icon on <application> already supplies the splash icon
         on API 31+ automatically -- no separate animated-icon attr
         needed. Unknown attrs are silently ignored on older API levels,
         so this single style covers every minSdk..compileSdk device. -->
    <style name="Theme.IqPuchinSplash" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
    </style>
</resources>
